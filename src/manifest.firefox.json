{
  "manifest_version": 3,
  "name": "DJ-CrateBuilder",
  "version": "0.1.0",
  "description": "Send YouTube and SoundCloud channels and tracks to the DJ-CrateBuilder desktop app.",
  "browser_specific_settings": {
    "gecko": {
      "id": "djcratebuilder@sintax.dev",
      "strict_min_version": "128.0",
      "update_url": "https://github.com/Sintax/DJ-CrateBuilder-Browser_Extensions/releases/latest/download/updates.json",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": ["contextMenus", "storage", "tabs"],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "action": {
    "default_title": "DJ-CrateBuilder",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://m.youtube.com/*",
        "https://soundcloud.com/*",
        "https://m.soundcloud.com/*"
      ],
      "js": ["content/inpage.js"],
      "run_at": "document_idle"
    }
  ]
}
